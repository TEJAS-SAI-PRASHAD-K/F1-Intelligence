# Local Postgres (already running via `brew services`, passwordless local auth)
DATABASE_URL=postgresql+psycopg://tejassaiprashad@localhost:5432/f1_intelligence
TEST_DATABASE_URL=postgresql+psycopg://tejassaiprashad@localhost:5432/f1_intelligence_test

# FastF1 caches every network fetch here. Essential — without it every
# re-run re-downloads session data.
FASTF1_CACHE_DIR=data/fastf1_cache

LOG_LEVEL=INFO

# Browser origins allowed to call the API, comma-separated. The default (set in
# app/config.py) is the local Vite dev server; a deployment should name its own
# frontend origin here. Not "*" — that would let any page a developer visits
# read this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
